<Window x:Class="PromptDeck.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PromptDeck — Copilot Connection Prototype" Width="1120" Height="820" MinWidth="860" MinHeight="650"
 Closing="Window_Closing" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/></Style>
 </Window.Resources>
 <Grid Margin="16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel>
   <StackPanel DockPanel.Dock="Top">
    <TextBlock Text="PromptDeck" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <Button Content="_New Session" Click="NewSession_Click"/>
    <Button x:Name="TestButton" Content="_Test Connection" Click="TestConnection_Click"/>
    <Button x:Name="CancelTestButton" Content="Cancel connection test" Click="CancelTest_Click" IsEnabled="False"/>
    <Button Content="Official _Login…" Click="Login_Click"/>
    <TextBlock Text="In the official CLI, enter /login. Then close it and test again." TextWrapping="Wrap" Margin="0,0,0,16"/>
    <TextBlock Text="Connection" FontWeight="SemiBold"/>
    <TextBlock x:Name="ConnectionStatus" Text="Not tested" TextWrapping="Wrap" Margin="0,4,0,16" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock Text="Sessions" FontWeight="SemiBold" Margin="0,0,0,8"/>
   </StackPanel>
   <ListBox x:Name="SessionList" ItemsSource="{Binding Sessions}" DisplayMemberPath="Title" SelectionChanged="SessionList_SelectionChanged" AutomationProperties.Name="Chat sessions"/>
  </DockPanel>
  <Grid Grid.Column="2">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="220" MinHeight="100"/></Grid.RowDefinitions>
   <Grid x:Name="ChatPanel">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding Id}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,12">
     <Label Content="_Model" Target="{Binding ElementName=ModelPicker}" Padding="0,0,0,4"/>
     <ComboBox x:Name="ModelPicker" ItemsSource="{Binding Models, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" MinHeight="32"/>
    </StackPanel>
    <TextBox Grid.Row="2" Text="{Binding Transcript, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Conversation" TextChanged="Conversation_TextChanged"/>
    <StackPanel Grid.Row="3" Margin="0,8,0,8">
     <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0"/>
     <Label Content="_Message (Ctrl+Enter to send)" Target="{Binding ElementName=MessageInput}" Padding="0,8,0,4"/>
     <TextBox x:Name="MessageInput" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="85" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsIdle}" PreviewKeyDown="MessageInput_KeyDown"/>
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal"><Button Content="_Send" Click="Send_Click" IsEnabled="{Binding IsIdle}"/><Button Content="_Cancel request" Click="CancelRequest_Click" IsEnabled="{Binding IsBusy}"/></StackPanel>
   </Grid>
   <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"/>
   <DockPanel Grid.Row="2">
    <TextBlock DockPanel.Dock="Top" Text="Diagnostics — chat content omitted; test response included" FontWeight="SemiBold" Margin="0,4,0,8"/>
    <TextBox x:Name="DiagnosticsBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Connection diagnostics"/>
   </DockPanel>
  </Grid>
 </Grid>
</Window>
